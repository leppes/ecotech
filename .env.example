# Copiar este archivo a .env (copy .env.example .env  /  cp .env.example .env).
# El .env NO se versiona (está en .gitignore); este archivo sí.
# Con SQLite no hay credenciales: estos valores sirven tal cual.

# Motor de base de datos (por ahora: sqlite)
DB_MOTOR=sqlite
# Archivo de la base
DB_NOMBRE=ecotech.db

# Solo para MySQL / PostgreSQL: se completan en el .env local, nunca aquí.
DB_HOST=
DB_USUARIO=
DB_PASSWORD=
