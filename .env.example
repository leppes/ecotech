# Copiar este archivo a .env y completar los valores.
# El .env NO se versiona (está en .gitignore); este archivo sí.

# Motor de base de datos (por ahora: sqlite)
DB_MOTOR=
# Archivo de la base, por ejemplo: ecotech.db
DB_NOMBRE=

# Solo para MySQL / PostgreSQL (en SQLite quedan vacíos)
DB_HOST=
DB_USUARIO=
DB_PASSWORD=
